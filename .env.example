# Supabase chỉ cần Email Provider; không cần bật Phone/Twilio.
# Bắt buộc điền đủ để ứng dụng kết nối Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_NAME=Điều phối xe Bệnh viện mắt Sài Gòn Trà Vinh
VITE_COORDINATOR_PHONE=0900000000
# Tùy chọn: địa chỉ HTTPS chính thức của hệ thống, ví dụ https://172.16.84.86:8443
VITE_PUBLIC_HTTPS_URL=
# true: Gemini kiểm tra mọi ảnh KM; false: chỉ gọi khi OCR cục bộ nghi ngờ
VITE_ODOMETER_GEMINI_VERIFY_ALL=true
