# ===== CHẠY LOCAL FRONTEND + SUPABASE ONLINE =====
# Copy file này thành .env.local rồi điền 2 giá trị Supabase.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
VITE_APP_NAME=Điều phối xe Bệnh viện mắt Sài Gòn Trà Vinh
VITE_COORDINATOR_PHONE=0900000000

# Desktop localhost có thể để trống.
# Nếu test điện thoại trong LAN bằng HTTPS, điền ví dụ:
# VITE_PUBLIC_HTTPS_URL=https://172.16.84.86:5173
VITE_PUBLIC_HTTPS_URL=

# OCR đồng hồ KM
VITE_ODOMETER_GEMINI_VERIFY_ALL=true

# HTTPS local tùy chọn. Không đặt VITE_ vì chỉ Vite dev server dùng.
# LOCAL_HTTPS_KEY=.certs/local-key.pem
# LOCAL_HTTPS_CERT=.certs/local-cert.pem

# Navicom gateway - frontend chỉ gọi gateway nội bộ, không chứa tài khoản/mật khẩu Navicom.
VITE_NAVICOM_GATEWAY_URL=/api/navicom
