# Navicom Gateway - production/server only. KHÔNG đưa mật khẩu vào frontend.
NAVICOM_GATEWAY_HOST=127.0.0.1
NAVICOM_GATEWAY_PORT=3020
TZ=Asia/Ho_Chi_Minh

# unconfigured | mock | cmsv6 | canonical-http
NAVICOM_MODE=cmsv6

# ===== CMSV6 STANDARD API THẬT =====
# Ví dụ: https://cam.example.com hoặc https://cam.example.com/808gps
NAVICOM_BASE_URL=https://domain-navicom-cua-ban.example
NAVICOM_USERNAME=
NAVICOM_PASSWORD=

# auto: thử mật khẩu thường trước, sau đó MD5 nếu server yêu cầu.
NAVICOM_CMSV6_PASSWORD_MODE=auto
# Để trống để gateway tự dò root API và /808gps.
NAVICOM_CMSV6_API_PREFIX=
# URL public dùng cho trang player HTML5. Để trống sẽ lấy origin của NAVICOM_BASE_URL.
NAVICOM_CMSV6_PUBLIC_BASE_URL=
NAVICOM_CMSV6_PLAYER_PATH=/808gps/open/player/video.html
NAVICOM_CMSV6_PLAYER_LANG=en
NAVICOM_CMSV6_STREAM=1
# Tài khoản hiện có 2 xe; mỗi xe 2 kênh: Camera trước + Camera cabin.
NAVICOM_CMSV6_CHANNELS=2
NAVICOM_CMSV6_VEHICLE_ACTIONS=StandardApiAction_queryUserVehicle.action,StandardApiAction_getUserVehicle.action
NAVICOM_CMSV6_SPEED_DIVISOR=10
NAVICOM_CMSV6_LOOKBACK_MINUTES=30
NAVICOM_CMSV6_OFFLINE_MINUTES=15
NAVICOM_CMSV6_FALLBACK_24H=true
NAVICOM_CMSV6_SESSION_TTL_SECONDS=1200
NAVICOM_CMSV6_TIMEOUT_MS=15000
NAVICOM_CMSV6_MAP_TYPE=1
NAVICOM_CMSV6_ACC_FIELD=ac

# Chỉ dùng để chạy test-cmsv6.mjs, không bắt buộc.
NAVICOM_TEST_DEVICE_ID=

# ===== CANONICAL HTTP (giữ lại để tương thích) =====
NAVICOM_TOKEN=
NAVICOM_AUTH_MODE=none
NAVICOM_STATUS_URL_TEMPLATE=

# ===== MOCK =====
NAVICOM_MOCK_LAT=
NAVICOM_MOCK_LNG=
NAVICOM_MOCK_SPEED=0
NAVICOM_MOCK_ADDRESS=
NAVICOM_MOCK_CHANNELS=2

# Xác thực quyền người dùng app trước khi cho xem camera/GPS.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Production PHẢI false.
NAVICOM_SKIP_AUTH=false
