# Chỉ lưu trên Ubuntu: /etc/bvmsgtv/trip-telemetry.env  (chmod 600)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_SECRET_SERVER_ONLY
SUPABASE_ANON_KEY=PASTE_SUPABASE_ANON_KEY
# Tạo tài khoản dành riêng cho collector có quyền fleet trên app, không dùng tài khoản cá nhân.
COLLECTOR_EMAIL=telemetry@example.com
COLLECTOR_PASSWORD=USE_A_STRONG_PASSWORD
NAVICOM_GATEWAY_URL=http://127.0.0.1:3020
SAMPLE_INTERVAL_MS=10000
